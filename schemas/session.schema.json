{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema_version",
    "session_id",
    "target_count",
    "scenario_ids",
    "current_index",
    "completed",
    "started_at",
    "development_mode",
    "phase"
  ],
  "properties": {
    "schema_version": { "const": 1, "type": "number" },
    "session_id": { "minLength": 1, "type": "string" },
    "target_count": {
      "anyOf": [
        { "const": 5, "type": "number" },
        { "const": 10, "type": "number" },
        { "const": 15, "type": "number" },
        { "const": 20, "type": "number" },
        { "const": 25, "type": "number" },
        { "const": 30, "type": "number" },
        { "const": 35, "type": "number" },
        { "const": 40, "type": "number" },
        { "const": 45, "type": "number" },
        { "const": 50, "type": "number" }
      ]
    },
    "scenario_ids": {
      "minItems": 5,
      "maxItems": 50,
      "type": "array",
      "items": { "minLength": 1, "type": "string" }
    },
    "current_index": { "minimum": 0, "maximum": 50, "type": "integer" },
    "completed": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "scenario_id",
          "selection_mode",
          "allocations",
          "expected_winner",
          "asset_ending_values",
          "year_one_leader",
          "ending_portfolio_value",
          "ending_benchmark_value",
          "max_drawdown"
        ],
        "properties": {
          "scenario_id": { "minLength": 1, "type": "string" },
          "selection_mode": {
            "anyOf": [
              { "const": "important", "type": "string" },
              { "const": "random", "type": "string" }
            ]
          },
          "allocations": {
            "additionalProperties": false,
            "minProperties": 7,
            "maxProperties": 7,
            "type": "object",
            "patternProperties": {
              "^(cash|bonds|us_total|international_ex_us|hot:[a-z0-9-]+:[a-z0-9-]+)$": {
                "minimum": 0,
                "maximum": 10000,
                "multipleOf": 500,
                "type": "integer"
              }
            }
          },
          "expected_winner": {
            "anyOf": [
              { "const": "cash", "type": "string" },
              { "const": "bonds", "type": "string" },
              { "const": "us_total", "type": "string" },
              { "const": "international_ex_us", "type": "string" },
              { "pattern": "^hot:[a-z0-9-]+:[a-z0-9-]+$", "type": "string" }
            ]
          },
          "asset_ending_values": {
            "additionalProperties": false,
            "minProperties": 7,
            "maxProperties": 7,
            "type": "object",
            "patternProperties": {
              "^(cash|bonds|us_total|international_ex_us|hot:[a-z0-9-]+:[a-z0-9-]+)$": {
                "minimum": 0,
                "type": "number"
              }
            }
          },
          "year_one_leader": {
            "anyOf": [
              { "const": "cash", "type": "string" },
              { "const": "bonds", "type": "string" },
              { "const": "us_total", "type": "string" },
              { "const": "international_ex_us", "type": "string" },
              { "pattern": "^hot:[a-z0-9-]+:[a-z0-9-]+$", "type": "string" }
            ]
          },
          "ending_portfolio_value": { "minimum": 0, "type": "number" },
          "ending_benchmark_value": { "minimum": 0, "type": "number" },
          "max_drawdown": { "minimum": 0, "maximum": 1, "type": "number" }
        }
      }
    },
    "started_at": { "format": "date-time", "type": "string" },
    "ended_at": { "format": "date-time", "type": "string" },
    "development_mode": { "type": "boolean" },
    "phase": {
      "anyOf": [
        { "const": "decision", "type": "string" },
        { "const": "reveal", "type": "string" },
        { "const": "checkpoint", "type": "string" },
        { "const": "final", "type": "string" }
      ]
    }
  }
}
