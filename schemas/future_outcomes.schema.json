{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "scenario_id",
    "monthly_returns",
    "return_sources",
    "events",
    "what_happened_next",
    "reflection"
  ],
  "properties": {
    "scenario_id": { "minLength": 1, "type": "string" },
    "monthly_returns": {
      "additionalProperties": false,
      "minProperties": 7,
      "maxProperties": 7,
      "type": "object",
      "patternProperties": {
        "^(cash|bonds|us_total|international_ex_us|hot:[a-z0-9-]+:[a-z0-9-]+)$": {
          "minItems": 60,
          "maxItems": 60,
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": ["month", "return"],
            "properties": {
              "month": {
                "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
                "type": "string"
              },
              "return": { "minimum": -1, "type": "number" }
            }
          }
        }
      }
    },
    "return_sources": {
      "additionalProperties": false,
      "minProperties": 7,
      "maxProperties": 7,
      "type": "object",
      "patternProperties": {
        "^(cash|bonds|us_total|international_ex_us|hot:[a-z0-9-]+:[a-z0-9-]+)$": {
          "minItems": 1,
          "uniqueItems": true,
          "type": "array",
          "items": { "minLength": 1, "type": "string" }
        }
      }
    },
    "events": {
      "minItems": 3,
      "maxItems": 5,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": ["month", "title", "description", "source_ids"],
        "properties": {
          "month": { "pattern": "^\\d{4}-(0[1-9]|1[0-2])$", "type": "string" },
          "title": { "minLength": 1, "type": "string" },
          "description": { "minLength": 1, "type": "string" },
          "source_ids": {
            "minItems": 1,
            "uniqueItems": true,
            "type": "array",
            "items": { "minLength": 1, "type": "string" }
          }
        }
      }
    },
    "what_happened_next": {
      "additionalProperties": false,
      "type": "object",
      "required": ["text", "source_ids"],
      "properties": {
        "text": { "minLength": 1, "type": "string" },
        "source_ids": {
          "minItems": 1,
          "uniqueItems": true,
          "type": "array",
          "items": { "minLength": 1, "type": "string" }
        }
      }
    },
    "reflection": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "what_people_were_focused_on",
        "what_actually_mattered",
        "what_faded_away",
        "what_nobody_knew",
        "source_ids"
      ],
      "properties": {
        "what_people_were_focused_on": { "minLength": 1, "type": "string" },
        "what_actually_mattered": { "minLength": 1, "type": "string" },
        "what_faded_away": { "minLength": 1, "type": "string" },
        "what_nobody_knew": { "minLength": 1, "type": "string" },
        "source_ids": {
          "minItems": 1,
          "uniqueItems": true,
          "type": "array",
          "items": { "minLength": 1, "type": "string" }
        }
      }
    }
  }
}
